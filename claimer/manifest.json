{
  "manifest_version": 3,
  "name": "Fab Free Claimer",
  "version": "1.5.1",
  "description": "Adds free Fab listings to your library, with filters. Unofficial, not affiliated with Epic Games.",
  "permissions": ["storage", "scripting", "alarms", "notifications"],
  "background": { "service_worker": "background.js" },
  "host_permissions": ["https://www.fab.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fab Free Claimer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.fab.com/*"],
      "exclude_matches": ["https://www.fab.com/payment/*"],
      "js": ["limited.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.fab.com/payment/web/purchase*"],
      "js": ["limited.js", "checkout-guard.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.fab.com/payment/web/purchase*"],
      "js": ["checkout.js"],
      "run_at": "document_start"
    }
  ]
}
